{
  "manifest_version": 3,
  "name": "MissCat",
  "version": "0.1.0",
  "description": "Hands a PR off to the current ChatGPT tab when badcat-host reports a valid +1. Local use only.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MissCat",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
